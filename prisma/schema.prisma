generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  password      String
  role          Role
  balance       Int      @default(0)
  parentId      String?  // Admin → Owner, Seller → Admin
  parent        User?    @relation("UserHierarchy", fields: [parentId], references: [id])
  children      User[]   @relation("UserHierarchy")

  hasUnreadPrize Boolean  @default(false)

  bets          Bet[]
  transfersSent     Transfer[] @relation("transferFrom")
  transfersReceived Transfer[] @relation("transferTo")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum Role {
  OWNER
  ADMIN
  SELLER
}

model Lottery {
  id            String   @id @default(cuid())
  name          String
  dayOfWeek     Int?     // 0–6 (Sunday–Saturday), null if one-time
  specificDate  DateTime? // For one-time lotteries
  playTime      String   // "HH:MM" 24h
  multiplier    Float
  status        LotteryStatus @default(ACTIVE)
  winningNumber Int?     // null until result is set
  winSetAt      DateTime? // When the winner was declared
  isRepeating   Boolean  @default(true)

  bets          Bet[]
}

enum LotteryStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

model Bet {
  id         String   @id @default(cuid())
  lotteryId  String
  sellerId   String
  number     Int
  amount     Int
  isWinner   Boolean   @default(false)
  prizeAmount Int      @default(0)
  createdAt  DateTime  @default(now())

  lottery    Lottery   @relation(fields: [lotteryId], references: [id])
  seller     User      @relation(fields: [sellerId], references: [id])
}

model Transfer {
  id        String   @id @default(cuid())
  fromUserId String?  // Null for SYSTEM recharge
  toUserId   String
  amount    Int
  type      TransferType
  createdAt DateTime @default(now())

  fromUser User? @relation("transferFrom", fields: [fromUserId], references: [id])
  toUser   User  @relation("transferTo", fields: [toUserId], references: [id])
}

enum TransferType {
  RECHARGE
  OWNER_TO_ADMIN
  ADMIN_TO_SELLER
}
